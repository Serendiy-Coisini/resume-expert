# 大模型配置（复制为 .env.local 后填写）
# 未配置 LLM_API_KEY 时自动使用 Mock 数据

# 必填：API Key（配置后自动切换为真实大模型）
LLM_API_KEY=sk-your-key-here

# 服务端环境变量 Key 默认禁用；确认部署环境可信后显式开启
ALLOW_SERVER_LLM_KEY=true

# ===== DeepSeek 示例（推荐）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_PROVIDER=deepseek

# ===== 其他 Provider =====
# OpenAI:   LLM_BASE_URL=https://api.openai.com/v1
#           LLM_MODEL=gpt-4o-mini
#           LLM_PROVIDER=openai
#
# Moonshot: LLM_BASE_URL=https://api.moonshot.cn/v1
#           LLM_MODEL=moonshot-v1-8k
#           LLM_PROVIDER=moonshot

# 可选：强制使用 Mock（即使有 API Key）
# USE_MOCK_AI=true
