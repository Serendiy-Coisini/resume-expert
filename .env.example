# 大模型配置（复制为 .env.local 后填写）
# 未配置 LLM_API_KEY 时自动使用 Mock 数据

# 必填：API Key（配置后自动切换为真实大模型）
LLM_API_KEY=sk-your-key-here

# 服务端环境变量 Key 默认禁用；确认部署环境可信后显式开启
ALLOW_SERVER_LLM_KEY=false

# 共享 Key 只支持明确声明的单实例部署；多实例请使用 BYOK 或外部统一鉴权/预算网关。
# 开启前给每位使用者生成一个独立随机口令（至少 32 字符），以 JSON 数组配置：
# SERVER_LLM_ACCESS_TOKENS=["replace-with-a-random-secret-at-least-32-characters"]
# SERVER_LLM_DEPLOYMENT=single-instance
# 实际上游调用次数预算（包含重试）；进程重启会重置计数，请同时设置服务商消费上限。
# SERVER_LLM_USER_DAILY_CALLS=40
# SERVER_LLM_TOTAL_DAILY_CALLS=200
# 仅当反向代理覆盖客户端传入的 IP 头时开启；默认使用保守公共限额。
# TRUST_PROXY_HEADERS=true

# ===== DeepSeek 示例（推荐）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_PROVIDER=deepseek

# ===== 其他 Provider =====
# OpenAI:   LLM_BASE_URL=https://api.openai.com/v1
#           LLM_MODEL=gpt-4o-mini
#           LLM_PROVIDER=openai
#
# Moonshot: LLM_BASE_URL=https://api.moonshot.cn/v1
#           LLM_MODEL=moonshot-v1-8k
#           LLM_PROVIDER=moonshot

# 可选：强制使用 Mock（即使有 API Key）
# USE_MOCK_AI=true
